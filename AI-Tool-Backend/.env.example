PROJECT_NAME="ScaleSocial Engine"
ENVIRONMENT="development"
API_V1_STR="/api/v1"

# --- Database ---
# Currently unused by the app itself (Supabase REST client is the real
# data-access path — see app/api/deps.py). Alembic reads this for
# migrations only. Get this from Supabase dashboard -> Project Settings ->
# Database -> Connection string (URI format).
DATABASE_URL=postgresql://postgres:your-password@your-project.supabase.co:5432/postgres

# --- Supabase Auth ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret
ALGORITHM=HS256

# --- Redis (Celery broker + backend) ---
# Local dev (plain `uvicorn`/`celery worker`, no Docker): redis://127.0.0.1:6379
# Docker Compose (web/worker containers talking to the `redis` service):
#   redis://redis:6379  <- MUST be the service name, not 127.0.0.1/localhost,
#   or the worker container can't reach it (confirmed bug — see Memory.md).
# Upstash (production): the rediss:// URL from your Upstash dashboard.
UPSTASH_REDIS_URL=redis://127.0.0.1:6379

# --- Gemini AI ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# --- Facebook / Instagram (Meta Graph API) ---
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_REDIRECT_URI=http://127.0.0.1:8000/api/v1/facebook/callback
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8000/api/v1/instagram/auth/callback
GRAPH_API_VERSION=v25.0
FRONTEND_URL=http://localhost:3000

# --- Twitter / X ---
TWITTER_CLIENT_ID=your-twitter-client-id
TWITTER_CLIENT_SECRET=your-twitter-client-secret
TWITTER_REDIRECT_URI=http://127.0.0.1:8000/api/v1/twitter/callback
TWITTER_OAUTH_SCOPES="tweet.read tweet.write users.read offline.access"
TWITTER_AUTHORIZE_URL=https://twitter.com/i/oauth2/authorize

# --- LinkedIn ---
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8000/api/v1/linkedin/callback
